# --- SERVER CONFIG ---
# Render requires you to use process.env.PORT (usually 10000 on their end)
# Katabump usually uses 3000 or 8080, but setting 1000 here is fine as it will be overridden by the host.
PORT=1000
OWNER_SECRET=blacknite_owner_2025
AI_SECRET_KEY=blacknite_ai_2025

# --- AI CONFIGURATION (GROQ) ---
# Your provided Groq API Key
OPENAI_API_KEY=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
# Groq API Base URL
AI_BASE_URL=https://api.groq.com/openai/v1
# Groq Model (Fast and highly intelligent)
AI_MODEL=llama3-70b-8192

# --- HOSTING DETECTION (AUTO) ---
# Set to true ONLY on Katabump to trigger Node 26.x mode
KATABUMP=false

# --- RENDER ANTI-SLEEP PING ---
# Used to keep your Render instance awake 24/7
RENDER_EXTERNAL_URL=https://blackn1te-nxs-1.onrender.com
APP_URL=https://blackn1te-nxs-1.onrender.com

# --- SESSION SECURITY ---
SESSION_SECRET=blacknite_session_secret_2025
